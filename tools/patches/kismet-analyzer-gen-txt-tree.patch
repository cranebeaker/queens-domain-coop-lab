+    static void GenTxtTree(EngineVersion ueVersion, string? mappings, string inputDir, string outputDir)
+    {
+        int ok = 0, failed = 0, skipped = 0;
+        foreach (var assetPath in Directory.EnumerateFiles(inputDir, "*.uasset", SearchOption.AllDirectories))
+        {
+            try
+            {
+                UAsset asset = LoadAsset(ueVersion, mappings, assetPath);
+                bool hasCode = false;
+                foreach (var e in asset.Exports) if (e is FunctionExport) { hasCode = true; break; }
+                if (!hasCode) { skipped++; continue; }
+                var rel = Path.GetRelativePath(inputDir, assetPath);
+                var outPath = Path.Join(outputDir, Path.ChangeExtension(rel, ".txt"));
+                Directory.CreateDirectory(Path.GetDirectoryName(outPath)!);
+                using var output = new StreamWriter(outPath);
+                new SummaryGenerator(asset, output, StreamWriter.Null).Summarize();
+                ok++;
+            }
+            catch (Exception ex)
+            {
+                failed++;
+                Console.Error.WriteLine($"{assetPath}: {ex.GetType().Name}: {ex.Message}");
+            }
+        }
+        Console.WriteLine($"decompiled {ok}, no code {skipped}, failed {failed}");
+    }
+
